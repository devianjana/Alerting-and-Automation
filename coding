import os
import numpy as np
import time
from sklearn.linear_model import LinearRegression
from twilio.rest import Client
from sendgrid import SendGridAPIClient
from sendgrid.helpers.mail import Mail

# Secure Config
TWILIO_SID = os.getenv("TWILIO_SID")
TWILIO_TOKEN = os.getenv("TWILIO_TOKEN")
TWILIO_PHONE = os.getenv("TWILIO_PHONE")
MY_PHONE = os.getenv("MY_PHONE")
SG_API_KEY = os.getenv("SENDGRID_API_KEY")
MY_EMAIL = os.getenv("MY_EMAIL")
FROM_EMAIL = os.getenv("FROM_EMAIL")


# 1️⃣ ALERT ENGINE
class AlertEngine:
    def __init__(self, threshold=80.0):
        self.threshold = threshold
        self.history = []

    def predict_overload(self):
        if len(self.history) < 5:
            return False
        
        X = np.arange(len(self.history)).reshape(-1, 1)
        y = np.array(self.history)
        model = LinearRegression().fit(X, y)
        prediction = model.predict([[len(self.history)]])[0]
        
        print(f"🔍 ML Prediction: {prediction:.2f}%")
        return prediction > self.threshold

    def check_rules(self, current_load):
        return current_load >= self.threshold


# 2️⃣ NOTIFIER
class Notifier:
    def __init__(self):
        self.twilio = Client(TWILIO_SID, TWILIO_TOKEN)
        self.sendgrid = SendGridAPIClient(SG_API_KEY)

    def send_sms(self, message):
        try:
            self.twilio.messages.create(
                body=message,
                from_=TWILIO_PHONE,
                to=MY_PHONE
            )
            print("✅ SMS Sent")
        except Exception as e:
            print("❌ SMS Error:", e)

    def send_email(self, message):
        try:
            mail = Mail(
                from_email=FROM_EMAIL,
                to_emails=MY_EMAIL,
                subject="🚨 SYSTEM ALERT",
                plain_text_content=message
            )
            self.sendgrid.send(mail)
            print("✅ Email Sent")
        except Exception as e:
            print("❌ Email Error:", e)

    def broadcast(self, message):
        print(f"\n🚨 ALERT TRIGGERED: {message}")
        self.send_sms(message)
        self.send_email(message)


# 3️⃣ EXECUTION
engine = AlertEngine(threshold=85.0)
notifier = Notifier()

simulated_stream = [60, 62, 65, 70, 75, 82, 88, 92]

print("\n--- Starting Secure Alert Engine ---")

for load in simulated_stream:
    print(f"\nMonitoring... Current Load: {load}%")
    engine.history.append(load)

    if engine.check_rules(load):
        notifier.broadcast(f"CRITICAL: Load reached {load}%!")

    elif engine.predict_overload():
        notifier.broadcast(
            f"WARNING: ML predicts load may exceed {engine.threshold}% soon."
        )

    time.sleep(2)
